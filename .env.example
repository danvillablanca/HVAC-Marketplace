# =============================================================================
# HVAC Connect - variables de entorno (copiar a .env / .env.local)
# Nunca subir claves reales al repositorio.
# =============================================================================

# ---- Backend (Next.js API) ----
# Supabase (usar las claves del proyecto local: `npx supabase status`)
# Proyecto remoto: https://paklzafoipzghfyftnfw.supabase.co
#   (claves en Dashboard > Project Settings > API Keys)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Gemini (modulo IA - dejar vacio para usar el modo contingencia)
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIM=1536

# Correos transaccionales (REQ-NOT-02). Sin clave, los correos se registran en el log.
RESEND_API_KEY=
EMAIL_FROM=HVAC Connect <onboarding@resend.dev>

# URL del frontend para CORS (separar multiples origenes con coma)
FRONTEND_ORIGIN=http://localhost:5173
BACKEND_PORT=3001

# Modo demo: activa fallbacks a datos en memoria cuando no hay Supabase.
# En produccion debe estar vacio o ausente.
DEMO_MODE=true

# ---- Frontend (Vite) ----
VITE_API_BASE_URL=http://localhost:3001
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-anon-key
# Tiles de MapLibre/MapTiler (https://cloud.maptiler.com - capa gratis 100k tiles/mes)
VITE_MAPTILER_KEY=
# Modo demo del frontend (activa auth demo con localStorage)
VITE_DEMO_MODE=true
# Login con Google (REQ-AUT-06). Solo "true" si Google esta configurado en Supabase
# (ver docs/guias/despliegue.md); si no, el boton se oculta.
VITE_GOOGLE_AUTH_ENABLED=false
