# =============================================================================
# Marketplace HVAC - variables de entorno (copiar a .env / .env.local)
# Nunca subir claves reales al repositorio.
# =============================================================================

# ---- Backend (Next.js API) ----
# Supabase (usar las claves del proyecto local: `npx supabase status`)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Gemini (modulo IA/RAG - diferido, dejar vacio para usar el stub)
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIM=1536

# URL del frontend para CORS
FRONTEND_ORIGIN=http://localhost:5173
BACKEND_PORT=3001

# ---- Frontend (Vite) ----
VITE_API_BASE_URL=http://localhost:3001
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-anon-key
# Tiles de MapLibre/MapTiler (https://cloud.maptiler.com - capa gratis 100k tiles/mes)
VITE_MAPTILER_KEY=
